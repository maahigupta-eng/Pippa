{
  // One Worker serves both the built site (dist/) and the API (/api/*).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pippa",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // The playbook is bundled into the Worker as plain text.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  // Pippa lives at pippa.<account>.workers.dev, with Cloudflare Access
  // switched on for that address in the dashboard (no custom domain needed).
  "workers_dev": true,
  // Keep logs so errors can be read in Cloudflare → pippa → Observability.
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pippa-db",
      // Paste the id printed by `npx wrangler d1 create pippa-db`.
      "database_id": "97756ee5-504b-4dd0-b5b4-46969cd38a49"
    }
  ],
  "vars": {
    "MODEL": "claude-sonnet-5-5",
    "DAILY_RUN_LIMIT": "15",
    "DAILY_CHAT_LIMIT": "40",
    "DAILY_SEARCH_LIMIT": "5",
    // Emails with Pippa Online (live search), comma-separated. Admins always have it.
    "ONLINE_EMAILS": "",
    // From Cloudflare Zero Trust: your team domain and the Access app's AUD tag.
    "ACCESS_TEAM_DOMAIN": "https://restless-thunder-4a00.cloudflareaccess.com",
    "ACCESS_AUD": "b230821a0b8d67ff75ac5b91b2b8b0b3d16151457864d951404964ce0c81992e",
    // Comma-separated admin emails (can see usage).
    "ADMIN_EMAILS": "maahigupta@gmail.com"
  }
  // Secret, set with: npx wrangler secret put ANTHROPIC_API_KEY
}

{
  "name": "pippa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "db:init:local": "wrangler d1 execute pippa-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute pippa-db --remote --file=./schema.sql",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "jose": "^6.2.18",
    "mammoth": "^1.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@types/node": "^22.20.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.6.0",
    "vite": "^8.4.0",
    "wrangler": "^4.168.0"
  }
}
